@scheme = http
@hostname = localhost
@port = 8080
@host = {{hostname}}:{{port}}
@baseUrl = {{scheme}}://{{host}}
@apiBase = {{baseUrl}}/v1
@json = application/json
# protected requests need a bearer token, generate one with: make token
@token = paste-output-of-make-token-here

### CREATE PRODUCT
# @name newproduct
POST {{apiBase}}/products
Content-Type: {{json}}

{
    "name": "product",
    "stock": 10,
    "price": {
        "minorAmount": 9,
        "currency": "PLN"
    }
}

@prodID = {{newproduct.response.body.$.id}}

### LIST PRODUCT
GET {{apiBase}}/products/{{prodID}}

### LIST PRODUCTS
GET {{apiBase}}/products

### LIST PRODUCTS (keyset paginated)
# next page: copy `nextCursor` from the response into the cursor query param
GET {{apiBase}}/products?limit=10&cursor=

### UPDATE PRODUCT
PUT {{apiBase}}/products/{{prodID}}
Content-Type: {{json}}

{
    "name": "t-shirt2",
    "price": {
        "minorAmount": 2006,
        "currency": "PLN"
    }
}

### CREATE ORDER
# @name createOrder
POST {{apiBase}}/orders
Content-Type: {{json}}
Authorization: Bearer {{token}}

{
    "productId": "{{prodID}}",
    "quantity": 2
}

@orderID = {{createOrder.response.body.$.id}}

### GET MY ORDER
GET {{apiBase}}/orders/{{orderID}}
Authorization: Bearer {{token}}

### LIST MY ORDERS
GET {{apiBase}}/orders?limit=10
Authorization: Bearer {{token}}

### LIST MY ORDERS (keyset paginated)
# next page: copy `nextCursor` from the response into the cursor query param
GET {{apiBase}}/orders?limit=10&cursor=
Authorization: Bearer {{token}}

### CREATE ORDER WITHOUT TOKEN (401)
POST {{apiBase}}/orders
Content-Type: {{json}}

{
    "productId": "{{prodID}}",
    "quantity": 2
}

### DELETE PRODUCT
# answers 409 Conflict when the product has orders
DELETE {{apiBase}}/products/{{prodID}}

### UPDATE PRODUCT WITH INCORRECT BODY
PUT {{apiBase}}/products/{{prodID}}
Content-Type: {{json}}

{   
    "price": "book",
    "email": 234,
    "name": 123
}

### CREATE PRODUCT WITH INCORRECT BODY
POST {{apiBase}}/products
Content-Type: {{json}}

{   
    "email": 234,
    "name": '123',
    "price": "book",
    "name": 123
}


### CREATE PRODUCT WITH EXTRA FIELD BODY
POST {{apiBase}}/products
Content-Type: {{json}}

{   
    "email": 234,
    "price": {
        "minorAmount": 123,
        "currency": "PLN"
    },
    "name": "abc"
}
